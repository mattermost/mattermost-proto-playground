{
  "name": "mattermost-proto-playground",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate:compass-icons": "node scripts/gen-compass-icon-manifest.mjs",
    "prebuild": "npm run generate:compass-icons && npm run build:ui && npm run build:proto",
    "predev": "node scripts/ensure-compass-ui.mjs",
    "prepreview": "node scripts/ensure-compass-ui.mjs",
    "build:ui": "npm run build --workspace=@mattermost/compass-ui",
    "build:proto": "npm run build --workspace=@mattermost/compass-proto",
    "smoke-test:ui": "node scripts/smoke-test-compass-ui-pack.mjs",
    "smoke-test:proto": "node scripts/smoke-test-compass-proto-pack.mjs",
    "smoke-test:packages": "npm run smoke-test:ui && npm run smoke-test:proto",
    "dev": "npm-run-all --parallel dev:ui dev:proto dev:app",
    "dev:app": "node scripts/wait-compass-ui-dist.mjs && vite",
    "dev:ui": "npm run dev --workspace=@mattermost/compass-ui",
    "dev:proto": "npm run dev --workspace=@mattermost/compass-proto",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "npm run storybook --workspace=@mattermost/compass-ui"
  },
  "dependencies": {
    "@fontsource/metropolis": "^5.2.5",
    "@fontsource/open-sans": "^5.2.7",
    "@mattermost/compass-icons": "^0.1.63",
    "@mattermost/compass-proto": "*",
    "@mattermost/compass-ui": "*",
    "@mdx-js/react": "^3.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "simplebar-react": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.83.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.0.5",
    "vite-plugin-svgr": "^4.5.0"
  }
}
