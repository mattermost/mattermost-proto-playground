{
  "name": "@mattermost/compass-ui",
  "version": "0.1.0-alpha.0",
  "description": "Compass design system UI components for Mattermost products",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "import": "./dist/compass-ui.css",
      "default": "./dist/compass-ui.css"
    },
    "./styles/standalone": {
      "import": "./dist/compass-ui-standalone.css",
      "default": "./dist/compass-ui-standalone.css"
    },
    "./component-styles": {
      "import": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:sass": "sass src/styles/entry.scss dist/compass-ui.css --load-path=src/styles --no-source-map && sass src/styles/standalone-entry.scss dist/compass-ui-standalone.css --load-path=src/styles --no-source-map",
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@mattermost/compass-icons": "^0.1.63",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "simplebar-react": "^3.3.2"
  },
  "peerDependenciesMeta": {
    "simplebar-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/metropolis": "^5.2.5",
    "@fontsource/open-sans": "^5.2.7",
    "@mattermost/compass-icons": "^0.1.63",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.83.4",
    "simplebar-react": "^3.3.2",
    "storybook": "^8.6.14",
    "typescript": "~5.7.2",
    "happy-dom": "^17.4.4",
    "vitest": "^3.0.5",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-svgr": "^4.5.0",
    "vite-plugin-lib-inject-css": "^2.2.1"
  }
}
